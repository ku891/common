#!/bin/sh /etc/rc.common

START=99

start() {
    echo "Starting services..."
    /etc/init.d/system restart
    /etc/init.d/uhttpd restart
    /etc/init.d/network restart
    /etc/init.d/dnsmasq restart

    # 补全 mtwifi 必填项，避免 htmode 为空导致 WiFi 起不来
    fix_mtwifi_wireless() {
        for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p'); do
            band=$(uci -q get wireless.$dev.band)
            htmode=$(uci -q get wireless.$dev.htmode)
            [ -n "$htmode" ] && continue
            case "$band" in
                2g) uci set wireless.$dev.htmode='HE40' ;;
                5g|6g) uci set wireless.$dev.htmode='HE160' ;;
            esac
        done
        uci commit wireless 2>/dev/null
    }
    fix_mtwifi_wireless

    # 重新加载无线配置
    [ -f "/etc/config/wireless" ] && wifi reload

    # 清理 LuCI 缓存
    rm -rf /tmp/luci-*cache* > /dev/null 2>&1

    # 确保每周一凌晨1点清理 LuCI 缓存
    if ! grep -q "/tmp/luci-\*cache\*" /etc/crontabs/root; then
        echo "0 1 * * 1 rm -rf /tmp/luci-*cache* > /dev/null 2>&1" >> /etc/crontabs/root
        /etc/init.d/cron restart
    fi

    # 执行自定义脚本
    [ -f "/etc/scripts_reboot" ] && /etc/scripts_reboot
}

stop() {
    echo "Service stopped."
}
